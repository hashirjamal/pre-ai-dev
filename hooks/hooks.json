{
  "description": "pre-ai-dev: session reminder and commit gate",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/commit-gate.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
